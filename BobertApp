import tkinter as tk
from panda3d.core import WindowProperties, loadPrcFileData
from direct.showbase.ShowBase import ShowBase
import threading
import time
from robot_simulator import RobotSimulator

#I don't want Panda3D to open a window automatically
loadPrcFileData('','window-type none')

class Bobert3D(ShowBase):
    def __init__(self, window_id):
        ShowBase.__init__(self)
        # ShowBase.ShowBase._init_(self)
        # # Prevent Panda3D from opening its own window
        # self.windowType = 'none'
        # ShowBase.__init__(self)

        # Set Panda window inside tkinter frame
        wp = WindowProperties()
        wp.setOrigin(0, 0)
        wp.setSize(800, 600)
        wp.setParentWindow(window_id)

        self.makeDefaultPipe()
        self.openDefaultWindow(props=wp, gsg=None)

        self.setBackgroundColor(0.1, 0.1, 0.2, 1)

        # 🔁 Launch robot simulation inside this Panda3D app
        self.sim = RobotSimulator(self)


def run_panda3d(window_id):
    app = Bobert3D(window_id)
    while True:                 
        app.taskMgr.step()  # ✅ Safe in background thread
        time.sleep(0.01)


def main():
    root = tk.Tk()
    root.title("Bobert Robot Controller")
    root.geometry("1000x700")

        # 🎥 Panda3D rendering area
    panda_frame = tk.Frame(root, width=800, height=600, bg="black")
    panda_frame.pack(pady=10)

        # 🔻 Bottom bar for status indicators
    bottom_bar = tk.Frame(root, height=50, bg="white")
    bottom_bar.pack(fill="x")

        # 🔴 Bluetooth status label
    bt_label = tk.Label(bottom_bar, text="Bluetooth: 🔴 Disconnected", font=("Arial", 12), bg="white", fg="red")
    bt_label.pack(side="left", padx=20)

        # 🚀 Run Panda3D in a background thread
    panda_thread = threading.Thread(target= run_panda3d, args=(panda_frame.winfo_id(),))
    panda_thread.daemon = True
    panda_thread.start()

        # 🪟 Launch tkinter GUI
    root.mainloop()


if __name__ == "__main__":
    main()
